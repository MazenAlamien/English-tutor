<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>المعلّم الصوتي</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600&display=swap">
<style>
:root{--bg:#eef3f6;--card:#fff;--ink:#12232e;--mut:#5d7080;--line:#d5dfe6;--me:#1f4e79;--meT:#fff;--tip:#e4f0f8;--mic:#e0475b;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#0f1a22;--card:#182731;--ink:#e6eef3;--mut:#93a7b5;--line:#2a3b47;--me:#2f6fa8;--tip:#1b3345}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#0f1a22;--card:#182731;--ink:#e6eef3;--mut:#93a7b5;--line:#2a3b47;--me:#2f6fa8;--tip:#1b3345}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font-family:"IBM Plex Sans Arabic",system-ui,sans-serif;display:flex;flex-direction:column;max-width:640px;margin:0 auto}
header{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;padding:10px 16px;border-bottom:1px solid var(--line)}
h1{font-size:1.05rem;margin:0;font-weight:600}
.sel{display:flex;gap:6px}
select,input{font:inherit;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:10px;padding:8px 10px}
select{max-width:46vw}
#chat{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px}
.m{max-width:85%;padding:10px 14px;border-radius:16px;line-height:1.6;white-space:pre-wrap}
.bot{align-self:flex-start;background:var(--card);border:1px solid var(--line);border-end-start-radius:4px}
.me{align-self:flex-end;background:var(--me);color:var(--meT);border-end-end-radius:4px}
.tip{align-self:flex-start;max-width:85%;background:var(--tip);color:var(--ink);font-size:.9rem;padding:8px 12px;border-radius:12px;line-height:1.6;white-space:pre-wrap}
.tip button{background:transparent;font-size:1rem;padding:2px 8px;margin-inline-start:6px;color:inherit}
.sys{align-self:center;color:var(--mut);font-size:.85rem;text-align:center}
#note{min-height:1.2em;padding:0 16px;color:var(--mut);font-size:.85rem;text-align:center}
footer{display:flex;gap:8px;align-items:center;padding:12px 16px;border-top:1px solid var(--line)}
#inp{flex:1;min-width:0}
button{font:inherit;cursor:pointer;border:0;border-radius:999px}
#mic{width:64px;height:64px;background:var(--mic);color:#fff;font-size:1.6rem;flex:none}
#mic.on{outline:4px solid var(--mic);outline-offset:3px}
#go{padding:10px 16px;background:var(--me);color:#fff}
button:disabled{opacity:.45;cursor:default}
:focus-visible{outline:3px solid var(--me);outline-offset:2px}
</style>
</head>
<body>
<header>
  <h1>المعلّم الصوتي</h1>
  <div class="sel">
    <select id="mode" aria-label="الوضع">
      <option value="learn">تعلّم الإنجليزية</option>
      <option value="translate">تحدّث بالعربية وترجمة</option>
      <option value="arabic">تعلّم العربية (للأجانب)</option>
    </select>
    <select id="lvl" aria-label="المستوى">
      <option value="beginner">مبتدئ</option>
      <option value="intermediate" selected>متوسط</option>
      <option value="advanced">متقدم</option>
    </select>
  </div>
</header>
<main id="chat" aria-live="polite"></main>
<div id="note"></div>
<footer>
  <button id="mic" aria-label="تحدّث">🎤</button>
  <input id="inp" dir="auto" placeholder="أو اكتب هنا" autocomplete="off">
  <button id="go">إرسال</button>
</footer>
<script>
const $=s=>document.querySelector(s);
const chat=$('#chat'),inp=$('#inp'),mic=$('#mic'),go=$('#go'),lvl=$('#lvl'),mode=$('#mode'),note=$('#note');
let hist=[],busy=false,cur=null;
const GREET={
  learn:'Hello! I am your English tutor. Tap the mic and say something.',
  translate:'قل شيئًا بالعربية وسأقوله لك بالإنجليزية.',
  arabic:'مرحبًا! أنا معلّمك للغة العربية. Say hello: مرحبًا'
};
const isAr=s=>/[\u0600-\u06FF]/.test(s);
const micLang=()=>mode.value==='learn'?'en-US':'ar-SA';
const replyLang=()=>mode.value==='arabic'?'ar':'en';

function add(cls,text,dir){const d=document.createElement('div');d.className=cls;if(dir)d.dir=dir;d.textContent=text;chat.appendChild(d);chat.scrollTop=chat.scrollHeight;return d}
function addTip(text){
  const d=document.createElement('div');d.className='tip';d.dir='auto';
  const s=document.createElement('span');s.textContent=text;
  const b=document.createElement('button');b.textContent='🔊';b.setAttribute('aria-label','استمع');
  b.onclick=()=>speak(text,isAr(text)?'ar':'en');
  d.append(s,b);chat.appendChild(d);chat.scrollTop=chat.scrollHeight;
}
function reset(){chat.innerHTML='';hist=[];note.textContent='';add('m bot',GREET[mode.value],'auto')}
mode.onchange=reset;

async function speak(t,lang){
  try{speechSynthesis.cancel()}catch(e){}
  if(cur){cur.pause();cur=null}
  try{
    const r=await fetch('/api/tts',{method:'POST',headers:{'Content-Type':'application/json','x-access-code':localStorage.getItem('code')||''},body:JSON.stringify({text:t,lang})});
    if(!r.ok)throw new Error('tts');
    cur=new Audio(URL.createObjectURL(await r.blob()));
    await cur.play();
  }catch(e){
    try{const u=new SpeechSynthesisUtterance(t);u.lang=lang==='ar'?'ar-SA':'en-US';u.rate=.9;speechSynthesis.speak(u)}catch(_){}
  }
}

async function send(){
  const text=inp.value.trim();
  if(!text||busy)return;
  inp.value='';add('m me',text,'auto');
  hist.push({role:'user',content:text});
  busy=true;go.disabled=true;
  const wait=add('sys','…');
  let win=hist.slice(-10);
  if(win[0].role!=='user')win=win.slice(1);
  try{
    const res=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json','x-access-code':localStorage.getItem('code')||''},body:JSON.stringify({messages:win,level:lvl.value,mode:mode.value})});
    if(res.status===401){const c=prompt('Access code');if(c)localStorage.setItem('code',c);throw new Error('auth')}
    if(!res.ok)throw new Error('http');
    const r=await res.json();
    const out=(r.text||'').trim(),p=out.split('|||');
    const reply=p[0].trim(),fix=(p[1]||'').trim();
    wait.remove();
    hist.push({role:'assistant',content:out});
    add('m bot',reply,'auto');
    if(fix)addTip(fix);
    speak(reply,replyLang());
  }catch(e){
    wait.remove();hist.pop();
    add('sys','تعذّر الحصول على رد. حاول مرة أخرى.');
  }
  busy=false;go.disabled=false;
}

let dictating=false,tm;
function dictate(){dictating=true;inp.focus();note.textContent='اضغط ميكروفون لوحة المفاتيح وتحدّث، وسأرسل رسالتك تلقائيًا.'}
inp.addEventListener('input',()=>{clearTimeout(tm);if(dictating&&inp.value.trim())tm=setTimeout(()=>{dictating=false;send()},1800)});

const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
if(!SR){mic.onclick=dictate;note.textContent='المتصفح لا يدعم التعرف على الصوت. استخدم ميكروفون الكيبورد.'}
else{
  const rec=new SR();rec.interimResults=true;
  let heard='';
  rec.onresult=e=>{heard=[...e.results].map(r=>r[0].transcript).join(' ');inp.value=heard};
  rec.onend=()=>{mic.classList.remove('on');if(heard.trim()){heard='';send()}};
  rec.onerror=e=>{mic.classList.remove('on');heard='';if(e.error!=='no-speech'&&e.error!=='aborted'){mic.onclick=dictate;dictate()}};
  mic.onclick=()=>{
    if(mic.classList.contains('on')){rec.stop();return}
    try{speechSynthesis.cancel();if(cur)cur.pause();rec.lang=micLang();heard='';inp.value='';rec.start();mic.classList.add('on')}catch(e){}
  };
}
go.onclick=send;
inp.addEventListener('keydown',e=>{if(e.key==='Enter')send()});
reset();
</script>
</body>
</html>
